<resources>
    <style name="Theme.WoWNote" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/wow_bg</item>
        <item name="android:statusBarColor">@color/wow_bg</item>
        <item name="android:windowBackground">@color/wow_bg</item>
        <item name="colorPrimary">@color/wow_accent</item>
        <item name="colorAccent">@color/wow_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
